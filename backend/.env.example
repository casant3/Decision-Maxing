# --- Decision Council backend configuration ---------------------------
# Copy to .env and fill in. All keys stay server-side; nothing here is
# ever sent to the client.

# Run entirely offline on the deterministic mock provider (default true).
# Set to false once at least one real API key below is configured; any
# role whose provider has no key silently degrades to the mock.
USE_MOCK_PROVIDERS=true

# SQLite needs no setup. For PostgreSQL:
#   DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/decision_council
DATABASE_URL=sqlite+aiosqlite:///./decision_council.db

CORS_ORIGINS=http://localhost:3000

# --- provider API keys -------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# Optional JSON file overriding the default model-role assignments
# (see app/config.py DEFAULT_ROLES for the shape).
ROLE_CONFIG_PATH=

# --- workflow budgets (cost control) -----------------------------------
# Nested settings use env_nested_delimiter-free JSON:
#   BUDGET='{"max_cost_usd": 2.5, "max_model_calls": 30}'
# Defaults: 3 clarification rounds, 40 model calls, 6 research queries,
# 400k input / 100k output tokens, $5.00, 15 minutes.
#BUDGET={"max_cost_usd": 5.0}

# Data retention in days; 0 keeps cases forever (MVP default).
RETENTION_DAYS=0
